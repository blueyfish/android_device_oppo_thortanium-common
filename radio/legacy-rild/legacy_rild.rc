# Both RIL daemons are needed for NV dump
# Running as root is needed.
service vendor.legacy-ril-daemon /vendor/bin/hw/legacy_rild
    class main
    user root
    group radio cache inet misc audio sdcard_r sdcard_rw diag oem_2901 log
    capabilities BLOCK_SUSPEND NET_ADMIN NET_RAW
    disabled
    oneshot

service vendor.legacy-ril-daemon2 /vendor/bin/hw/legacy_rild -c 2
    class main
    user root
    group radio cache inet misc audio sdcard_r sdcard_rw diag oem_2901 log
    capabilities BLOCK_SUSPEND NET_ADMIN NET_RAW
    disabled
    oneshot

service vendor.legacy-ril-sh /vendor/bin/legacy_rild.sh
    class main
    user root
    oneshot

# Stop when IMEI is written
on property:oppo.device.imeicache=*
    stop vendor.legacy-ril-sh
    stop vendor.legacy-ril-daemon
    stop vendor.legacy-ril-daemon2
    setprop vendor.radio.qcrild.enabled true
    setprop persist.vendor.radio.imeicache ${oppo.device.imeicache}

on property:oppo.device.meidcache=*
    setprop persist.vendor.radio.meidcache ${oppo.device.meidcache}

# Check if IMEI/MEID is stored in persistent property
on boot && property:persist.vendor.radio.imeicache=*
    setprop oppo.device.imeicache ${persist.vendor.radio.imeicache}

on boot && property:persist.vendor.radio.meidcache=*
    setprop oppo.device.meidcache ${persist.vendor.radio.meidcache}
