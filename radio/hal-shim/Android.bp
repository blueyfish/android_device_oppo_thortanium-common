cc_library_shared {
    name: "libril-qcril-oppo",
    proprietary: true,
    defaults: ["hidl_defaults"],
    srcs: [
        "qcril_functions.cpp",
        "qcril_shim.cpp",
    ],
    cflags: [
        "-Werror",
        "-Wextra",
        "-Wall",
    ],
    shared_libs: [
        "libbase",
        "libdl",
    ],
}
